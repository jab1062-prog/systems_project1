# Comments and blank lines do nothing.

echo hello# comment
cat
echo after-cat
echo first > data
echo second >> data
cat < data > copy
cat < copy
echo replacement > data
cat < data
seq 1 50000 | cat | wc -l
pwd > location
cat < location
cd / | cat
pwd
echo *.txt
echo absent*
echo foo*bar
echo *.txt foo*bar
echo sub/*.txt
which echo /bin/cat which
